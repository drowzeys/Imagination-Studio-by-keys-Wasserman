# GHCR carrier for Wasserman Slate AI Studio, powered by TensorFold (Mac + DGX Spark), one image for both builds. This is NOT a
# runtime: neither Metal nor the Spark's models run in it. For a DGX Spark it carries the prebuilt CUDA engines
# (/payload/spark-engine: H3; /payload/spark-music3: MiniMax Music 3's music3-generate; /payload/spark-drama3: Fish Audio
# Drama 3's drama3-generate and libtensorfold_drama3.so, the engine only, no codec or weights); for a Mac it carries
# the pinned TensorFold wheel (with the H3 and Qwen-Image families), the dependency lock and the render scripts;
# oneshot-setup.sh copies them out and installs natively on the Mac. It holds no model weights.
#
#   docker run --rm -v "$PWD":/out ghcr.io/drowzeys/keys-tensorfold-studio:4.2.1 cp -a /payload/. /out/
FROM busybox:1.37
LABEL org.opencontainers.image.source="https://github.com/drowzeys/Imagination-Studio-by-keys-Wasserman"
LABEL org.opencontainers.image.description="Carrier (not a runtime): Wasserman Slate AI Studio, powered by TensorFold (Mac + DGX Spark) 4.2.1, both builds: the DGX Spark's prebuilt CUDA engines (H3 with LoRA support, MiniMax Music 3, NVIDIA Nemotron 3.5 Bolt, Fish Audio Drama 3); for Macs the TensorFold wheel with the MiniMax H3 and Qwen-Image-2.1 families, the prebuilt native Zig + Metal FastH3 engine, dependency lock and render scripts for Apple Silicon"
LABEL org.opencontainers.image.licenses="Apache-2.0"
COPY payload/ /payload/
